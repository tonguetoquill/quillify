{
	"name": "@quillmark/quillify",
	"version": "0.8.0",
	"description": "Turn a published PDF form (AcroForm or XFA) into a Quillmark quill, in the browser.",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Quillmark Contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tonguetoquill/quillify.git"
	},
	"bugs": {
		"url": "https://github.com/tonguetoquill/quillify/issues"
	},
	"homepage": "https://github.com/tonguetoquill/quillify#readme",
	"keywords": [
		"quillmark",
		"pdf",
		"acroform",
		"xfa",
		"forms"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"assets",
		"NOTICE",
		"licenses"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"gate": "npm run build && npm run lint && npm run check && npm test",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"check": "tsc",
		"test": "vitest run",
		"assets": "node scripts/assets.js",
		"build": "npm run assets && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"corpus": "npm run assets && vitest run --config corpus/vitest.config.ts"
	},
	"devDependencies": {
		"@neslinesli93/qpdf-wasm": "0.3.0",
		"@quillmark/wasm": "0.134.1",
		"@types/node": "24.19.0",
		"@vitest/browser-playwright": "5.0.2",
		"fast-check": "4.10.2",
		"playwright": "1.63.0",
		"prettier": "3.9.9",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vitest": "5.0.2"
	},
	"dependencies": {
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.4.299"
	},
	"peerDependencies": {
		"@quillmark/wasm": ">=0.133.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
